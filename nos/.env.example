# ============================================================
# nós — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA suba o .env.local pro git.
# ============================================================

# Endereço público do site, sem barra no final (usado em links de e-mail, pagamento e compartilhamento)
SITE_URL=http://localhost:3000

# ---- banco de dados (libSQL / SQLite) -----------------------
# local: arquivo no próprio computador
DATABASE_URL=file:./data/nos.db
# produção (Turso): DATABASE_URL=libsql://nome-do-banco.turso.io
DATABASE_AUTH_TOKEN=

# ---- painel administrativo ---------------------------------
# Segredo para assinar a sessão (gere com: openssl rand -base64 48)
AUTH_SECRET=troque-isto-por-um-segredo-longo-e-aleatorio-com-48-caracteres
# Primeiro acesso ao painel (criado pelo "npm run db:seed")
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# ---- pagamentos ------------------------------------------
# mock = modo teste (nada é cobrado) | mercadopago | stripe
PAYMENT_PROVIDER=mock
# minutos que a vaga fica reservada enquanto a pessoa paga
SPOT_HOLD_MINUTES=30
# a partir de quantas vagas restantes o status automático vira "últimas vagas"
LAST_SPOTS_THRESHOLD=5

# Mercado Pago (https://www.mercadopago.com.br/developers/panel/app)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_USE_SANDBOX=false

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- fotos -----------------------------------------------
# local (pasta ./storage/uploads) | vercel-blob
STORAGE_PROVIDER=local
UPLOAD_DIR=./storage/uploads
BLOB_READ_WRITE_TOKEN=

# ---- confirmações ------------------------------------------
# console (só mostra no terminal) | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="nós <ola@seudominio.com.br>"
EMAIL_REPLY_TO=
# none | console | webhook (POST para Z-API, Twilio, Make, Zapier...)
WHATSAPP_PROVIDER=none
WHATSAPP_WEBHOOK_URL=

# ---- instagram (opcional) ---------------------------------
# Com token, a home mostra os últimos posts de verdade
INSTAGRAM_ACCESS_TOKEN=
