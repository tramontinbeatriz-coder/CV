---
import { about } from '../content/site';
import { rich } from '../lib/rich';
import SectionHeader from './SectionHeader.astro';
import Media from './Media.astro';
---

<section class="section about" id="about">
  <div class="container">
    <SectionHeader number={about.number} label={about.label} headline={about.headline} lede={about.lede} />

    <div class="about__grid grid">
      <aside class="about__side">
        <div data-reveal><Media image={about.portrait} /></div>
        <dl class="about__facts" data-reveal>
          {about.facts.map((f) => (
            <div>
              <dt class="label">{f.label}</dt>
              <dd set:html={rich(f.value)} />
            </div>
          ))}
        </dl>
      </aside>

      <div class="about__story">
        <div class="prose">
          {about.paragraphs.map((p, i) => <p data-reveal style={`--i: ${i}`}>{p}</p>)}
        </div>
        <blockquote class="about__quote h3" data-reveal>
          <span aria-hidden="true">“</span>{about.quote}<span aria-hidden="true">”</span>
        </blockquote>
      </div>
    </div>

    <ol class="path" aria-label="Path" style={`--n: ${about.path.length}`}>
      {about.path.map((s, i) => (
        <li class:list={["path__step", { "path__step--now": s.when === "Now" }]} data-reveal style={`--i: ${i}`}>
          <div class="path__top">
            <span class="path__n">{s.step}</span>
            <span class="path__when label" set:html={rich(s.when)} />
          </div>
          <h3 class="h4">{s.title}</h3>
          <p>{s.detail}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .about__grid { row-gap: 3rem; }
  .about__side { grid-column: 1 / span 4; display: grid; gap: 2rem; align-content: start; }
  .about__story { grid-column: 6 / -1; display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-content: start; }

  .about__facts > div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-small);
  }
  .about__facts dt { padding-top: 0.15rem; }

  .about__quote {
    padding-left: clamp(1rem, 3vw, 2rem);
    border-left: 1px solid var(--accent);
    max-width: 22ch;
    color: var(--ink);
  }
  .about__quote span { color: var(--accent); }

  .path {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin-top: clamp(4rem, 9vw, 8rem);
    counter-reset: step;
  }
  .path__step {
    position: relative;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.5rem clamp(1rem, 2vw, 1.75rem) 0 0;
    border-top: 1px solid var(--ink);
  }
  .path__step::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--ink);
  }
  .path__step--now::before { background: var(--accent); border-color: var(--accent); }
  .path__top { display: flex; justify-content: space-between; align-items: baseline; }
  .path__n { font-family: var(--serif); font-size: 1.1rem; color: var(--accent); }
  .path__step p { font-size: var(--fs-small); color: var(--muted); max-width: 28ch; }

  @media (max-width: 960px) {
    .about__side, .about__story { grid-column: 1 / -1; }
    .about__side { grid-template-columns: 1fr 1fr; align-items: start; }
    .path { grid-template-columns: 1fr 1fr 1fr; row-gap: 2.5rem; }
  }
  @media (max-width: 620px) {
    .about__side { grid-template-columns: 1fr; }
    .path { grid-template-columns: 1fr; row-gap: 0; }
    .path__step { border-top: 0; border-left: 1px solid var(--ink); padding: 0 0 2rem 1.5rem; }
    .path__step::before { top: 0.35rem; left: -5px; }
  }
</style>
