---
import { contact, person } from '../content/site';
import { plain, rich, safeHref } from '../lib/rich';
import SectionHeader from './SectionHeader.astro';

const { linkedin, email } = person.links;
const emailAddress = plain(email.label);
---

<section class="contact" id="contact">
  <div class="container">
    <SectionHeader number={contact.number} label={contact.label} headline={contact.headline} lede={contact.lede} tone="ink" />

    <ul class="contact__list">
      <li data-reveal>
        <span class="label">LinkedIn</span>
        <a class="contact__big" href={safeHref(linkedin.href)} target="_blank" rel="noopener">
          <span>Connect on LinkedIn</span>
          <span class="arrow arrow--diag" aria-hidden="true">↗</span>
        </a>
      </li>
      <li data-reveal style="--i: 1">
        <span class="label">Email</span>
        <div class="contact__row">
          <a class="contact__big" href={safeHref(email.href)}>
            <span set:html={rich(email.label)} />
            <span class="arrow arrow--right" aria-hidden="true">→</span>
          </a>
          <button
            class="contact__copy"
            type="button"
            data-copy={emailAddress}
            data-copied-label={contact.copiedLabel}
          >
            {contact.copyLabel}
          </button>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .contact {
    background: var(--ink);
    color: var(--ink-paper);
    padding-top: var(--section-y);
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }
  .contact :global(.h2) { max-width: 12ch; font-size: clamp(3rem, 7.5vw, 7rem); }
  .contact__list { display: grid; }
  .contact__list li {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    align-items: center;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--ink-line);
  }
  .contact__list li:last-child { border-bottom: 1px solid var(--ink-line); }
  .contact__list .label { grid-column: 1 / span 3; color: var(--ink-muted); }
  .contact__list li > a, .contact__row { grid-column: 4 / -1; }
  .contact__row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .contact__big {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--serif);
    font-size: var(--fs-h3);
    line-height: 1.1;
    letter-spacing: -0.02em;
    transition: color 0.3s var(--ease);
    overflow-wrap: anywhere;
  }
  .contact__big:hover { color: var(--accent-on-ink); }
  .contact__copy {
    font-size: var(--fs-small);
    padding: 0.6em 1.2em;
    border: 1px solid var(--ink-line);
    border-radius: 999px;
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .contact__copy:hover, .contact__copy.is-copied { border-color: var(--accent-on-ink); color: var(--accent-on-ink); }
  .contact :global(.ph) { background: rgb(226 130 92 / 0.14); color: var(--accent-on-ink); }
  .contact :global(:focus-visible) { outline-color: var(--accent-on-ink); }

  @media (max-width: 860px) {
    .contact__list .label, .contact__list li > a, .contact__row { grid-column: 1 / -1; }
    .contact__list .label { margin-bottom: 0.5rem; }
  }
</style>
