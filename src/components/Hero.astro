---
import { hero, person } from '../content/site';
import { rich, safeHref } from '../lib/rich';
import Media from './Media.astro';

const linkedin = person.links.linkedin;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid grid">
    <p class="hero__eyebrow label">{hero.eyebrow}</p>

    <h1 class="hero__title" id="hero-title">
      <span class="hero__name">{person.name}</span>
      <span class="display hero__headline" set:html={rich(hero.headline)} />
    </h1>

    <div class="hero__portrait">
      <Media image={hero.portrait} eager />
    </div>

    <div class="hero__intro">
      <p class="lede">{hero.intro}</p>
      <div class="hero__ctas">
        <a class="btn btn--solid" href={hero.ctas.primary.href}>
          {hero.ctas.primary.label} <span class="arrow arrow--down" aria-hidden="true">↓</span>
        </a>
        <a class="btn btn--ghost" href={hero.ctas.secondary.href}>{hero.ctas.secondary.label}</a>
        <a class="link hero__li" href={safeHref(linkedin.href)} target="_blank" rel="noopener">
          {linkedin.label} <span class="arrow arrow--diag" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <dl class="hero__status">
      {hero.status.map((s) => (
        <div>
          <dt class="label">{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: stretch;
    padding-top: clamp(6.5rem, 12vh, 9rem);
    padding-bottom: 2rem;
  }
  .hero__grid {
    grid-template-rows: auto 1fr auto auto;
    row-gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .hero__eyebrow { grid-column: 1 / span 8; }

  .hero__title { grid-column: 1 / span 9; font-weight: 400; align-self: center; }
  .hero__name {
    display: block;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    font-family: var(--sans);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero__headline { display: block; max-width: 11ch; }

  .hero__portrait { grid-column: 10 / -1; grid-row: 1 / span 2; align-self: end; }

  .hero__intro { grid-column: 1 / span 7; display: grid; gap: 2rem; }
  .hero__intro .lede { max-width: 40ch; }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; }
  .hero__li { margin-left: 0.5rem; font-size: var(--fs-small); }

  .hero__status {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    padding-top: 1.25rem;
    margin-top: clamp(1rem, 4vh, 3rem);
    border-top: 1px solid var(--line);
  }
  .hero__status dd { margin-top: 0.35rem; font-size: var(--fs-small); color: var(--ink-2); }

  /* Load-in choreography (CSS only) */
  .hero__eyebrow, .hero__name, .hero__headline, .hero__intro, .hero__portrait, .hero__status {
    animation: rise 1.1s var(--ease) both;
  }
  .hero__name { animation-delay: 0.1s; }
  .hero__headline { animation-delay: 0.2s; }
  .hero__portrait { animation-delay: 0.35s; }
  .hero__intro { animation-delay: 0.45s; }
  .hero__status { animation-delay: 0.6s; }
  @keyframes rise { from { opacity: 0; transform: translateY(28px); } }

  @media (max-width: 960px) {
    .hero { min-height: auto; }
    .hero__grid { grid-template-rows: none; }
    .hero__eyebrow, .hero__title, .hero__intro { grid-column: 1 / -1; }
    .hero__portrait { grid-column: 1 / span 7; grid-row: auto; order: 3; max-width: 360px; }
    .hero__intro { order: 2; }
    .hero__status { order: 4; grid-template-columns: 1fr; gap: 1rem; }
    .hero__status > div { display: flex; justify-content: space-between; gap: 1rem; }
    .hero__status dd { margin: 0; text-align: right; }
  }
  @media (max-width: 560px) {
    .hero__portrait { grid-column: 1 / -1; max-width: none; }
    .hero__ctas .btn { flex: 1 1 auto; justify-content: center; }
    .hero__li { margin: 0.5rem 0 0; }
  }
</style>
