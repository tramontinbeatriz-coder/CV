---
/**
 * Image slot. Renders the real photo when `src` is set,
 * otherwise a clearly labelled placeholder describing exactly which photo belongs here.
 */
import type { ImageSlot } from '../content/site';
import { url } from '../lib/rich';

interface Props {
  image: ImageSlot;
  eager?: boolean;
  class?: string;
  tone?: 'paper' | 'ink';
}

const { image, eager = false, class: className = '', tone = 'paper' } = Astro.props;
const ratio = image.ratio ?? '4/3';
---

<figure class:list={['media', `media--${tone}`, className]} style={`--ratio: ${ratio}`}>
  {
    image.src ? (
      <img
        src={url(image.src)}
        alt={image.alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : 'auto'}
      />
    ) : (
      <div class="media__ph" role="img" aria-label={`Image placeholder: ${image.alt}`}>
        <span class="media__tag">Photo · {ratio.replace('/', ':')}</span>
        <p class="media__brief">{image.brief}</p>
        <span class="media__corner media__corner--tl" aria-hidden="true" />
        <span class="media__corner media__corner--br" aria-hidden="true" />
      </div>
    )
  }
</figure>

<style>
  .media {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--paper-2);
    border-radius: 2px;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .media__ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(0.9rem, 2vw, 1.5rem);
    background:
      repeating-linear-gradient(135deg, transparent 0 22px, rgb(27 26 24 / 0.035) 22px 23px),
      var(--paper-2);
  }
  .media__tag {
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
  }
  .media__brief {
    max-width: 44ch;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .media__corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--accent);
    border-style: solid;
    border-width: 0;
  }
  .media__corner--tl { top: 8px; right: 8px; border-top-width: 1px; border-right-width: 1px; }
  .media__corner--br { bottom: 8px; left: 8px; border-bottom-width: 1px; border-left-width: 1px; }

  .media--ink { background: #2a2825; }
  .media--ink .media__ph {
    background:
      repeating-linear-gradient(135deg, transparent 0 22px, rgb(255 255 255 / 0.04) 22px 23px),
      #2a2825;
  }
  .media--ink .media__brief { color: var(--ink-muted); }
  .media--ink .media__tag,
  .media--ink .media__corner { color: var(--accent-on-ink); border-color: var(--accent-on-ink); }
</style>
