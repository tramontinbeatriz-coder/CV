---
import type { Metric } from '../content/site';
import { rich } from '../lib/rich';

interface Props {
  metric: Metric;
  size?: 'lg' | 'md';
}

const { metric, size = 'lg' } = Astro.props;

// Split "+120%" / "20+" into prefix · number · suffix so the number can count up.
const match = !metric.placeholder ? metric.value.match(/^([^\d]*)(\d+)(.*)$/) : null;
---

<div class:list={['metric', `metric--${size}`, { 'metric--ph': metric.placeholder }]}>
  {
    match ? (
      <p class="metric__value" data-count={match[2]} data-prefix={match[1]} data-suffix={match[3]}>
        {metric.value}
      </p>
    ) : (
      <p class="metric__value" set:html={rich(metric.value)} />
    )
  }
  <p class="metric__label" set:html={rich(metric.label)} />
</div>

<style>
  .metric {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid currentColor;
    border-color: var(--line);
  }
  .metric__value {
    font-family: var(--serif);
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .metric--lg .metric__value { font-size: min(6.5rem, 38cqi); }
  .metric--md .metric__value { font-size: min(4rem, 30cqi); }
  .metric__label {
    max-width: 22ch;
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--muted);
  }
  .metric--ph .metric__value { font-size: min(3rem, 24cqi); }
  .metric--ph .metric__value :global(.ph) { border-bottom-width: 1px; }
</style>
