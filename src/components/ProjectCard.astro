---
/**
 * Project entry on the home page. Typographic by default; a cover photo is shown when one is set.
 *  - feature: lead case, large title + large metrics
 *  - row: editorial row, text left + metrics & challenge right
 */
import type { Project } from '../content/site';
import { rich, url } from '../lib/rich';
import Media from './Media.astro';
import MetricRow from './MetricRow.astro';

interface Props {
  project: Project;
  variant?: 'feature' | 'row';
}

const { project: p, variant = 'row' } = Astro.props;
const href = url(`/work/${p.slug}/`);
---

<article class:list={['pc', `pc--${variant}`]}>
  {p.cover && (
    <a class="pc__media" href={href} tabindex="-1" aria-hidden="true" data-reveal>
      <Media image={p.cover} />
    </a>
  )}

  <div class="pc__body">
    <p class="pc__kicker label" data-reveal><span class="pc__index">{p.index}</span> {p.kicker}</p>
    <h3 class="h3" data-reveal>
      <a href={href}>{p.title}</a>
    </h3>
    <p class="pc__tagline" data-reveal set:html={rich(p.tagline)} />
    <a class="pc__more link" href={href} data-reveal>
      Read the case <span class="arrow arrow--right" aria-hidden="true">→</span>
    </a>
  </div>

  <div class="pc__aside">
    <MetricRow metrics={p.metrics} size={variant === 'feature' ? 'lg' : 'md'} />
    {variant === 'row' && (
      <dl class="pc__facts" data-reveal>
        <div><dt class="label">Challenge</dt><dd set:html={rich(p.challenge)} /></div>
      </dl>
    )}
  </div>
</article>

<style>
  .pc {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }
  .pc__media { grid-column: 1 / -1; display: block; overflow: hidden; }
  .pc__media:hover :global(img) { transform: scale(1.03); }

  .pc__body { grid-column: 1 / span 5; display: grid; gap: 1.25rem; align-content: start; }
  .pc__aside { grid-column: 7 / -1; display: grid; gap: 2rem; align-content: start; }

  .pc__kicker { display: flex; gap: 0.75rem; }
  .pc__index { color: var(--accent); }
  .pc h3 a { transition: color 0.3s var(--ease); }
  .pc h3 a:hover { color: var(--accent); }
  .pc__tagline { font-family: var(--serif); font-size: var(--fs-h4); line-height: 1.2; color: var(--ink-2); max-width: 30ch; }
  .pc__more { justify-self: start; font-size: var(--fs-small); margin-top: 0.5rem; }

  .pc__facts { font-size: var(--fs-small); color: var(--ink-2); }
  .pc__facts > div { display: grid; gap: 0.35rem; }
  .pc__facts dd { max-width: 56ch; }

  .pc--feature { border-top: 0; padding-top: 0; }
  .pc--feature h3 { font-size: var(--fs-h2); }

  @media (max-width: 960px) {
    .pc__body, .pc__aside { grid-column: 1 / -1; }
  }
</style>
